    fig.add_trace(go.Scatter(x=idx, y=sm - 2 * sd, line=dict(width=1), name="BB alt"))
    fig.add_trace(go.Scatter(x=idx, y=sm, line=dict(width=1, dash="dot"), name="SMA20"))
