def get_risk_params(sektor: str = SEKTOR) -> Dict[str, Any]:
    """Sektör risk profilini varsayılan risk matrisiyle birleştirip döndürür (doğrulanmış)."""
    if sektor not in SEKTOR_BOTLARI:
        raise KeyError(f"Bilinmeyen sektör: {sektor!r} (seçenekler: {sorted(SEKTOR_BOTLARI)})")
    rp = dict(DEFAULT_RISK)
    rp.update(SEKTOR_BOTLARI[sektor]["risk_profil"])
    validate_risk_params(rp)
    return rp


def validate_risk_params(rp: Dict[str, Any]) -> None:
    """Risk parametrelerinin mantıksal aralıklarını denetler. Sorun varsa tümünü listeleyip ValueError atar."""
    problems: List[str] = []

    def in_range(key: str, lo: float, hi: float) -> None:
        v = rp.get(key)
        if not isinstance(v, (int, float)) or isinstance(v, bool) or not math.isfinite(float(v)):
            problems.append(f"{key} geçersiz: {v!r}")
        elif not (lo <= float(v) <= hi):
            problems.append(f"{key}={v} aralık dışı [{lo}, {hi}]")

    in_range("risk_per_trade", 1e-5, 0.05)
    in_range("sl_atr", 0.1, 10.0)
    in_range("tp_r", 0.1, 10.0)
    in_range("max_pos", 1e-3, 1.0)
    in_range("max_exposure", 0.0, 1.0)
    in_range("max_sector", 0.0, 1.0)
    in_range("max_dd", 0.0, 100.0)
    in_range("daily_loss", 0.0, 100.0)
    in_range("max_positions", 1, 100)
    in_range("max_hold", 1, 10_000)
    in_range("max_trades_day", 1, 1_000)
    in_range("p_buy", 0.0, 1.0)
    in_range("p_sell", 0.0, 1.0)
    in_range("unc_max", 0.0, 10.0)
    in_range("kelly_frac", 0.0, 1.0)
    if problems:
        raise ValueError("Risk parametreleri geçersiz: " + "; ".join(problems))


